# URL pública do site, sem barra final. Preencha quando o domínio existir.
# Usada em canonical, Open Graph, robots.txt, sitemap.xml e dados estruturados.
# Vazia: o site funciona, mas omite essas URLs absolutas.
NEXT_PUBLIC_SITE_URL=

# Medição (opcional). Sem os IDs, nenhum script de rastreamento é carregado.
# GA4: "ID da métrica" (G-XXXXXXXXXX). Meta: ID do pixel no Gerenciador de Eventos.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
